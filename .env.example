# 이 파일은 "키 이름 목록"일 뿐이에요. 진짜 값은 여기에 쓰지 마세요!
# 실제 값은 Vercel 대시보드 → Settings → Environment Variables 에 등록합니다.
# (로컬 테스트용 진짜 값은 .env 에만 — .env 는 git 에 올라가지 않아요)

# Supabase 프로젝트 주소 (Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase anon(공개) 키 (Project Settings → API → anon public)
# ※ service_role 키는 절대 넣지 마세요
SUPABASE_ANON_KEY=
